mmentaryUrl":"https://foundation.binothaimeen.net/ar/books/show/7c9cb3e2-3b02-4ad9-97dc-5db895d9a98c","qr":{"s":29,"b":"/tAj/BMFkG6ffrt1F1Xbq+guwWOpB/qqr+AVTACL59/P54MfwMXR4svL9bNuRsFki0H87qO3tqNL0yt36BdjgF7M4dIKIOuYPnxG/IBbbEf6QmuwTEsSusd/3dFgKK6M5x8EvJ2/7K7pAA=="},"dedupeKey":"كلسلامىمنالناسعليهصدقةكليومتطلعفيهالشمستعدلبيناثنينصدقةوتعينالرجلفيدابتهوالكلمةالطيبةصدقةو"},{"id":"nawawi-27","collection":"nawawi","collectionLabel":"الأربعون النووية","n":27,"title":"البر والإثم","rawi":"","matn":"البر حسن الخلق، والإثم ما حاك في صدرك وكرهت أن يطلع عليه الناس... واستفت قلبك؛ البر ما اطمأنت إليه النفس واطمأن إليه القلب، والإثم ما حاك في النفس وتردد في الصدر وإن أفتاك الناس وأفتوك.","book":"الأربعون النووية","position":"الحديث 27","takhrij":"صدره عن النواس بن سمعان رواه مسلم، وحديث وابصة رواه أحمد والدارمي كما ذكر النووي.","sourceUrl":"https://sunnah.com/nawawi40:27","sourceDomain":"sunnah.com","commentaryUrl":"https://foundation.binothaimeen.net/ar/books/show/7c9cb3e2-3b02-4ad9-97dc-5db895d9a98c","qr":{"s":29,"b":"/sAj/BKFkG6Zfrt1d1Xbr2guwVupB/qqr+AXTACL79/NDAMf5sHR47D79bunRsF6D0H/yIO3pBlL08Ln6BbvAF7Ju9IKUPuYPTtG/IBPbEf7QmuwS0sSusd/3dJgKK6Jxx8EkJ2/6K7pAA=="},"dedupeKey":"البرحسنالخلقوالاثمماحاكفيصدركوكرهتانيطلععليهالناسواستفتقلبكالبرمااطمانتاليهالنفسواطماناليه"},{"id":"nawawi-28","collection":"nawawi","collectionLabel":"الأربعون النووية","n":28,"title":"التمسك بالسنة عند الاختلاف","rawi":"","matn":"أوصيكم بتقوى الله... فإنه من يعش منكم فسيرى اختلافًا كثيرًا، فعليكم بسنتي وسنة الخلفاء الراشدين المهديين... وإياكم ومحدثات الأمور؛ فإن كل بدعة ضلالة.","book":"الأربعون النووية","position":"الحديث 28","takhrij":"رواه أبو داود والترمذي، وقال الترمذي: حديث حسن صحيح.","sourceUrl":"https://sunnah.com/nawawi40:28","sourceDomain":"sunnah.com","commentaryUrl":"https://foundation.binothaimeen.net/ar/books/show/7c9cb3e2-3b02-4ad9-97dc-5db895d9a98c","qr":{"s":29,"b":"/hyz/BXe0G6TpLt0jnXbqyEuwSodB/qqr+AB3gCqO0iWwNhyR78KjpLS0SWwD+WeevckSG4BbSLZmptTeloNWzNquwlm0+K8qeYP+AB+3F/4L+twTdkbuqvvldL7RS62vHMEXrkv6VfNgA=="},"dedupeKey":"اوصيكمبتقوىاللهفانهمنيعشمنكمفسيرىاختلافاكثيرافعليكمبسنتيوسنةالخلفاءالراشدينالمهديينواياكمو"},{"id":"nawawi-29","collection":"nawawi","collectionLabel":"الأربعون النووية","n":29,"title":"أبواب الخير وحفظ اللسان","rawi":"","matn":"تعبد الله لا تشرك به شيئًا، وتقيم الصلاة، وتؤتي الزكاة، وتصوم رمضان، وتحج البيت... الصوم جنة، والصدقة تطفئ الخطيئة كما يطفئ الماء النار، وصلاة الرجل في جوف الليل... ورأس الأمر الإسلام وعموده الصلاة... ثم أخذ بلسانه وقال: كف عليك هذا... وهل يكب الناس في النار على وجوههم إلا حصائد ألسنتهم.","book":"الأربعون النووية","position":"الحديث 29","takhrij":"رواه الترمذي، وقال: حديث حسن صحيح.","sourceUrl":"https://sunnah.com/nawawi40:29","sourceDomain":"sunnah.com","commentaryUrl":"https://foundation.binothaimeen.net/ar/books/show/7c9cb3e2-3b02-4ad9-97dc-5db895d9a98c","qr":{"s":29,"b":"/u87/BZmEG6WKrt11pXbpC8uwSr9B/qqr+AbPQC3PXJaA7v8QrUybdEBXx73NwY4HXkc6Hbi5ztXov77mdNiVQuh2eroQHyERLns/gBk5H/7zGtQVOEYukhvrdfDpq6wEksESlqv7tn1AA=="},"dedupeKey":"تعبداللهلاتشركبهشيياوتقيمالصلاةوتوتيالزكاةوتصومرمضانوتحجالبيتالصومجنةوالصدقةتطفيالخطييةكما"},{"id":"nawawi-30","collection":"nawawi","collectionLabel":"الأربعون النووية","n":30,"title":"حدود الله وما سكت عنه","rawi":"","matn":"إن الله فرض فرائض فلا تضيعوها، وحد حدودًا فلا تعتدوها، وحرم أشياء فلا تنتهكوها، وسكت عن أشياء رحمة لكم غير نسيان فلا تبحثوا عنها.","book":"الأربعون النووية","position":"الحديث 30","takhrij":"رواه الدارقطني وغيره، وذكره النووي في الأربعين.","sourceUrl":"https://sunnah.com/nawawi40:30","sourceDomain":"sunnah.com","commentaryUrl":"https://foundation.binothaimeen.net/ar/books/show/7c9cb3e2-3b02-4ad9-97dc-5db895d9a98c","qr":{"s":29,"b":"/vc7/BZmEG6OKrt1tpXbpK8uwSr9B/qqr+AcPQC3ZXJdJrv8VdkybLERXxOxNwYKlXkfepbi7S9Xoq7bmdGtVQug3+roGGyERXfs/gBQ5H/6rGtQXuEYulBvrdWDpq60sksEZhqv76n1AA=="},"dedupeKey":"اناللهفرضفرايضفلاتضيعوهاوحدحدودافلاتعتدوهاوحرماشياءفلاتنتهكوهاوسكتعناشياءرحمةلكمغيرنسيانفل"},{"id":"nawawi-31","collection":"nawawi","collectionLabel":"الأربعون النووية",